# URL of the optional Go API. When unset, the site reads backend/data/projects.json
# at build time and works on static hosting (Netlify).
PORTFOLIO_API_URL=http://localhost:8080

# Base URL of the Go API used by the contact form in the browser.
# Local development: http://localhost:8080. Clear it on Netlify so the form
# posts to the built-in /api/contact route.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public site URL (used for metadata and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Allowed CORS origins for the Go API (comma separated).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Contact delivery. Configure at least one of the options below for /api/contact.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CONTACT_WEBHOOK_URL=
